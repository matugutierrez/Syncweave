{
  "name": "syncweave",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time collaborative editor powered by a from-scratch CRDT engine",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/crdt && npm run build --workspace server && npm run build --workspace client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "test": "npm run test --workspace packages/crdt",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
